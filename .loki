# frozen_string_literal: true
# robot_lab-experiment — experimental self-building RobotLab pipeline. A Rails
# app, not a packaged gem, so it imports the shared task files by name and
# leaves out dev/gem_tasks.loki (build/install/release) — mirrors
# sqa_project/sqa-rails/.loki, the only other non-gem app in this asgard
# ecosystem. dev/quality_rails.loki adds the Rails-specific gates (Brakeman,
# RailsBestPractices, ActiveRecordDoctor), which `asgard quality` discovers
# automatically alongside the standard *_check gates.

import_up "dev/quality.loki"
import_up "dev/quality_rails.loki"
import_up "dev/git.loki"
import_up "dev/iterm_tasks.loki"
import_up "dev/doc_tasks.loki"

class Tasks
  # This app's source lives under app/ (lib/ holds only rake tasks), so point
  # the structural gates (flog / flay / reek / fasterer) at both.
  @@quality_dirs = %w[app lib].freeze

  header "robot_lab-experiment — self-building RobotLab pipeline (Rails app)"

  desc "Install dependencies and prepare the database"
  def setup
    sh "bin/setup"
  end

  desc "Start the Rails dev server (Puma + Tailwind watcher)"
  def server
    sh "bin/dev"
  end

  desc "Open the Rails console"
  def console
    sh "bin/rails console"
  end

  desc "Run database migrations"
  def migrate
    sh "bin/rails db:migrate"
  end
end
