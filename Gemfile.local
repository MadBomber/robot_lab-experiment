# frozen_string_literal: true

eval_gemfile "Gemfile"

# Cross-gem development: local robot_lab checkouts.
gem "robot_lab", path: "../robot_lab"
gem "robot_lab-rails", path: "../robot_lab-rails"

# Local provider checkout while its on_event hook is unreleased.
gem "ruby_llm-providers-claude_code", path: "../../ruby_llm-providers_project/claude_code",
                                      require: "ruby_llm/providers/claude_code"
