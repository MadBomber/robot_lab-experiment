<div class="mx-auto w-full max-w-lg">
  <%= render layout: "shared/page_header",
        locals: { title: "New task in #{@project.name}",
                  crumbs: [["Projects", projects_path], [@project.name, project_path(@project)], ["New task", nil]] } do %>
  <% end %>

  <% if params[:from_issue].present? %>
    <p class="mt-4 text-sm text-muted-foreground">Pre-filled from issue #<%= params[:from_issue] %> -- review before creating.</p>
  <% end %>

  <%# Not poetry_webmcp_form: poetry:check's registry currently projects
      that helper as yieldless, but this form needs the yielded builder for
      f.input -- the guidance form (which composes bare controls) carries
      the app's WebMCP form example instead. %>
  <%= form_with model: @task, url: project_tasks_path(@project),
        builder: Poetry::Ui::FormBuilder, class: "mt-6" do |f| %>
    <%= poetry_field_group do %>
      <%# Carries the issue linkage from the from_issue prefill through the
          POST, so the project page can show the task's status on that issue
          row instead of another "Create task" button. %>
      <%= f.hidden_field :github_issue_number %>
      <%= f.input :title %>
      <%= f.input :description, as: :text, rows: 6, label: "Describe the work",
            hint: "Becomes the task doc's original request." %>
      <%= f.submit "Create task" %>
    <% end %>
  <% end %>
</div>
