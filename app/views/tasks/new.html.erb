<div class="mx-auto w-full max-w-lg">
  <h1 class="mb-2 text-2xl font-semibold tracking-tight">New task in <%= @project.name %></h1>

  <% if params[:from_issue].present? %>
    <p class="mb-4 text-sm text-muted-foreground">Pre-filled from issue #<%= params[:from_issue] %> -- review before creating.</p>
  <% end %>

  <%= form_with model: @task, url: project_tasks_path(@project), builder: Poetry::Ui::FormBuilder, class: "mt-4" do |f| %>
    <%= poetry_field_group do %>
      <%= f.input :title %>
      <%= f.input :description, as: :text, rows: 6, label: "Describe the work",
            hint: "Becomes the task doc's original request." %>
      <%= f.submit "Create task" %>
    <% end %>
  <% end %>
</div>
