<div class="w-full">
  <%= render "task_header", task: @task, project: @project %>

  <div class="mt-5 grid items-start gap-5 lg:grid-cols-[18rem_minmax(0,1fr)]">
    <%= render "task_controls", task: @task, project: @project, doc_content: @doc_content %>

    <section class="min-w-0" data-controller="transcript">
      <div class="mb-3 flex items-center justify-between">
        <span class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Transcript</span>
        <%= poetry_toggle(variant: :outline, size: :sm,
              data: { action: "poetry:toggle:change->transcript#syncCollapsed" }) { "Collapse tool calls" } %>
      </div>

      <%= turbo_stream_from "task_#{@task.id}" %>
      <%= poetry_message_scroller(id: "transcript", class: "h-[70vh]") do %>
        <%= render partial: "messages/message", collection: @messages, as: :message %>
      <% end %>

      <%= render "tasks/agent_status", running: @task.running_agent_run.present?, task: @task %>
    </section>
  </div>
</div>
