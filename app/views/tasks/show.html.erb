<% content_for(:head) do %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<% end %>

<div class="tp-page">
  <%= render "task_header", task: @task, project: @project %>

  <div class="tp-layout">
    <%= render "task_controls", task: @task, project: @project, doc_content: @doc_content %>

    <main class="min-w-0">
      <div class="tp-toolbar">
        <span class="tp-eyebrow">Transcript</span>
        <label class="tp-check">
          <input type="checkbox" id="tp-collapse-toggle">
          Collapse tool calls
        </label>
      </div>

      <%= turbo_stream_from "task_#{@task.id}" %>
      <div id="transcript" class="tp-transcript">
        <%= render partial: "messages/message", collection: @messages, as: :message %>
      </div>

      <%= render "tasks/agent_status", running: @task.running_agent_run.present?, task: @task %>
    </main>
  </div>
</div>
