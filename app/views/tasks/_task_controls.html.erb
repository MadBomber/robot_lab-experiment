<aside class="flex min-w-0 flex-col gap-4 lg:sticky lg:top-5" id="task-sidebar">
  <%= poetry_card do |card| %>
    <% card.with_title { "Task" } %>
    <div class="space-y-3">
      <%= form_with url: update_status_project_task_path(project, task), method: :patch,
            class: "flex items-center justify-between gap-2" do %>
        <span class="text-sm text-muted-foreground">Status</span>
        <span class="flex items-center gap-1">
          <%= poetry_native_select(name: "status", size: :sm, label: "Task status",
                options: Task.statuses.keys.map { |s| [s.humanize, s] }, selected: task.status) %>
          <%= poetry_button(variant: :secondary, size: :sm, type: :submit) { "Set" } %>
        </span>
      <% end %>

      <%= poetry_meter(label: "Workflow runs", value: task.workflow_run_count, max: Task::MAX_WORKFLOW_RUNS,
            value_text: "#{task.workflow_run_count} of #{Task::MAX_WORKFLOW_RUNS}") %>

      <div class="flex flex-wrap gap-2">
        <% task.runnable_agent_types.each do |agent_type| %>
          <%= form_with url: project_task_agent_runs_path(project, task), method: :post, class: "inline" do %>
            <%= hidden_field_tag :agent_type, agent_type %>
            <%= poetry_button(size: :sm, type: :submit) { "Run #{agent_type}" } %>
          <% end %>
        <% end %>
        <% if task.running_agent_run.present? %>
          <%= form_with url: stop_project_task_path(project, task), method: :post, class: "inline" do %>
            <%= poetry_button(variant: :destructive, size: :sm, type: :submit) { "Stop" } %>
          <% end %>
          <%= form_with url: pause_project_task_path(project, task), method: :post, class: "inline" do %>
            <%= poetry_button(variant: :outline, size: :sm, type: :submit) { "Pause" } %>
          <% end %>
        <% end %>
        <% if task.blocked? %>
          <%= form_with url: unblock_project_task_path(project, task), method: :post, class: "inline" do %>
            <%= poetry_button(variant: :outline, size: :sm, type: :submit) { "Resume" } %>
          <% end %>
        <% end %>
        <% unless task.completed? || task.blocked_reason == "abandoned" %>
          <%= form_with url: abandon_project_task_path(project, task), method: :post, class: "inline",
                data: { turbo_confirm: "Give up on this task and stop all agents?" } do %>
            <%= poetry_button(variant: :ghost, size: :sm, type: :submit) { "Abandon" } %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% unless task.completed? %>
    <%= poetry_card do |card| %>
      <%= poetry_collapsible(open: task.pending_guidance?) do |collapsible| %>
        <% collapsible.with_trigger { "Give the agents guidance" } %>
        <div class="space-y-2 pt-2">
          <% if task.pending_guidance? %>
            <p class="text-xs text-muted-foreground">Queued for the next run: <em><%= task.pending_guidance %></em></p>
          <% end %>
          <%# poetry_webmcp_form declares this form as a WebMCP tool so a
              browser agent can queue guidance; a person submits it as before
              (mutating forms always keep the human's Submit). %>
          <%= poetry_webmcp_form(url: guide_project_task_path(project, task), method: :post,
                tool: { name: "give_agent_guidance",
                        description: "Queue guidance that steers this task's next agent run." },
                class: "space-y-2") do %>
            <%= poetry_field(id: "task_guidance", label_text: "Guidance",
                  hint: "Applied on the next run. To redirect an in-flight run, Stop it first.") do |field| %>
              <%= poetry_textarea(name: "guidance", rows: 3,
                    placeholder: "e.g. use the Playwright MCP server, not Selenium",
                    **field.control_attributes) %>
            <% end %>
            <%= poetry_button(type: :submit, class: "w-full") { "Send guidance" } %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%= poetry_card do |card| %>
    <%= poetry_collapsible(open: doc_content.present?) do |collapsible| %>
      <% collapsible.with_trigger { "Task doc" } %>
      <div class="pt-2">
        <%= poetry_code_block(code: doc_content.presence || "(empty)", language: "markdown",
              label: "Task doc", class: "max-h-80 overflow-y-auto") %>
      </div>
    <% end %>
  <% end %>
</aside>
