<%# The task page's header: breadcrumb, title, the status WORD beside its
    color (never color alone), the run counter, and -- for fix tasks -- the
    pipeline tracker: poetry_timeline in its horizontal step-tracker mode,
    each stage carrying its own status word. %>
<header id="task-header" class="flex flex-col gap-4">
  <%= poetry_breadcrumb do |crumb| %>
    <% crumb.with_item("Projects", href: projects_path) %>
    <% crumb.with_item(project.name, href: project_path(project)) %>
    <% crumb.with_item(task.title) %>
  <% end %>

  <div class="flex flex-wrap items-start justify-between gap-4">
    <h1 class="min-w-0 text-xl font-semibold tracking-tight"><%= task.title %></h1>
    <div class="flex shrink-0 flex-wrap items-center gap-3">
      <%= poetry_badge(variant: task_status_variant(task),
            class: ("task-status-blocked" if task.blocked?)) do %>
        <%= poetry_spinner(label: "Agent running", class: "size-3") if task.running_agent_run %>
        <%= task_status_word(task) %><%=
          if task.blocked?
            " — #{task.blocked_reason.humanize.downcase}"
          elsif task.running_agent_run
            " — #{task.running_agent_run.agent_type}"
          end %>
      <% end %>
      <span class="font-mono text-xs tabular-nums text-muted-foreground">run <%= task.workflow_run_count %> of <%= Task::MAX_WORKFLOW_RUNS %></span>
    </div>
  </div>

  <% if task.blocked? && task.blocked_detail? %>
    <div class="task-blocked-detail text-xs text-muted-foreground">
      <span><%= task.blocked_detail %></span>
      <% blocked_run = task.blocked_run_id? ? AgentRun.find_by(id: task.blocked_run_id) : nil %>
      <% if blocked_run %>
        &middot; <%= poetry_link(href: project_task_agent_run_path(task.project, task, blocked_run)) { "run ##{blocked_run.id}" } %>
      <% end %>
    </div>
  <% end %>

  <% if task.fix? %>
    <%= poetry_timeline(orientation: :horizontal, "aria-label": "Pipeline progress") do |timeline| %>
      <% Task::PIPELINE_STAGES.each do |stage| %>
        <% word, variant = pipeline_stage_badge(task, stage) %>
        <% timeline.with_item(title: pipeline_stage_title(stage),
              completed: task.pipeline_stage_status(stage) == :done) do %>
          <%= poetry_badge(variant:) { word } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= poetry_separator %>
</header>
