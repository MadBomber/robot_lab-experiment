<div class="tp-header" id="task-header">
  <div class="tp-crumbrow">
    <div class="tp-crumb">
      <span class="tp-proj"><%= link_to project.name, project %></span>
      <span class="tp-sep">/</span>
      <h1><%= task.title %></h1>
    </div>
    <div class="tp-headmeta">
      <% if task.blocked? %>
        <span class="tp-pill tp-pill-blocked">blocked (<%= task.blocked_reason %>)</span>
      <% elsif task.running_agent_run.present? %>
        <span class="tp-pill tp-pill-running"><span class="tp-dot"></span><%= task.running_agent_run.agent_type %> running</span>
      <% else %>
        <span class="tp-pill"><%= task.status %></span>
      <% end %>
      <span class="tp-runs">runs <%= task.workflow_run_count %>/<%= Task::MAX_WORKFLOW_RUNS %></span>
    </div>
  </div>

  <% if task.blocked? && task.blocked_detail? %>
    <div class="tp-blocked-detail">
      <span><%= task.blocked_detail %></span>
      <% blocked_run = task.blocked_run_id? ? AgentRun.find_by(id: task.blocked_run_id) : nil %>
      <% if blocked_run %>
        &middot; <%= link_to "run ##{blocked_run.id}", project_task_agent_run_path(task.project, task, blocked_run) %>
      <% end %>
    </div>
  <% end %>

  <% if task.fix? %>
    <div class="tp-stepper">
      <% Task::PIPELINE_STAGES.each do |stage| %>
        <% status = task.pipeline_stage_status(stage) %>
        <div class="tp-stage <%= "is-#{status}" if status != :pending %>">
          <div class="tp-node">
            <% if status == :done %>
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10" /></svg>
            <% else %>
              <%= Task::PIPELINE_STAGES.index(stage) + 1 %>
            <% end %>
          </div>
          <div class="tp-label"><%= stage.capitalize %></div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
