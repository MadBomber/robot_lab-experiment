<div id="agent-status">
  <% if running %>
    <div class="mt-3 flex items-center gap-3 rounded-lg border border-dashed border-border px-4 py-3 text-sm text-muted-foreground"
      <% if task %>
        data-controller="heartbeat"
        data-heartbeat-url-value="<%= heartbeat_project_task_path(task.project_id, task) %>"
      <% end %>>
      <%= poetry_spinner(label: "Agent working", class: "size-4 text-primary") %>
      <span>
        Agent working &middot;
        <span class="font-mono tabular-nums" data-heartbeat-target="elapsed">...</span> &middot;
        <span class="font-mono tabular-nums" data-heartbeat-target="count">0</span> messages
      </span>
    </div>
  <% end %>
</div>
