<% case message.msg_type %>
<% when "user", "assistant", "system", "result" %>
  <%= poetry_message_scroller_item(id: message.id) do %>
    <div class="mb-2 rounded-lg border border-border bg-card px-4 py-3">
      <div class="flex items-center gap-2">
        <%= poetry_icon(name: message_icon_name(message.msg_type), class: "size-4 text-muted-foreground") %>
        <%= poetry_badge(variant: message_badge_variant(message.msg_type)) { message.msg_type.humanize } %>
        <% if message.created_at %>
          <span class="ms-auto font-mono text-xs tabular-nums text-muted-foreground"><%= message.created_at.strftime("%H:%M:%S") %></span>
        <% end %>
      </div>
      <div class="mt-2 whitespace-pre-wrap text-sm"><%= message.payload["text"] || message.payload["content"] %></div>
    </div>
  <% end %>
<% when "assistant_thinking", "tool_use", "tool_result" %>
  <%= poetry_message_scroller_item(id: message.id) do %>
    <details class="group mb-2 rounded-lg border border-border bg-card"
      data-transcript-target="details" <%= "open" unless message.assistant_thinking? %>>
      <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 [&::-webkit-details-marker]:hidden">
        <%= poetry_icon(name: :"chevron-right", class: "size-3.5 shrink-0 text-muted-foreground transition-transform group-open:rotate-90") %>
        <%= poetry_icon(name: message_icon_name(message.msg_type), class: "size-4 shrink-0 text-muted-foreground") %>
        <%= poetry_badge(variant: message_badge_variant(message.msg_type)) do %>
          <%= message.tool_use? ? message.payload["tool_name"] : message.msg_type.humanize %>
        <% end %>
        <span class="min-w-0 flex-1 truncate font-mono text-xs text-muted-foreground group-open:hidden"><%= message_summary_line(message) %></span>
        <% if message.created_at %>
          <span class="ms-auto shrink-0 font-mono text-xs tabular-nums text-muted-foreground"><%= message.created_at.strftime("%H:%M:%S") %></span>
        <% end %>
      </summary>
      <div class="px-4 pb-3">
        <% body = message.tool_use? ? message.payload["tool_input"] : (message.payload["text"] || message.payload["content"]) %>
        <%= poetry_code_block(code: body.to_s, language: "text", label: "#{message.msg_type.humanize} detail") %>
      </div>
    </details>
  <% end %>
<% else %>
  <%= poetry_message_scroller_item(id: message.id) do %>
    <div class="mb-2 rounded-lg border border-border bg-card px-4 py-3">
      <div class="flex items-center gap-2">
        <%= poetry_icon(name: message_icon_name(message.msg_type), class: "size-4 text-muted-foreground") %>
        <%= poetry_badge(variant: :outline) { message.msg_type } %>
      </div>
      <pre class="mt-2 whitespace-pre-wrap text-sm"><%= message.payload %></pre>
    </div>
  <% end %>
<% end %>
