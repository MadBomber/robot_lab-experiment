<div class="mx-auto w-full max-w-3xl">
  <header class="flex flex-col gap-4">
    <%= poetry_breadcrumb do |crumb| %>
      <% crumb.with_item("Projects", href: projects_path) %>
      <% crumb.with_item(@project.name) %>
    <% end %>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="space-y-1">
        <h1 class="text-2xl font-semibold tracking-tight"><%= @project.name %></h1>
        <p class="font-mono text-sm text-muted-foreground"><%= @project.effective_cwd %></p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <%= poetry_button(variant: :outline, href: edit_project_path(@project)) { "Edit" } %>
        <%= form_with url: project_audit_tasks_path(@project), method: :post, class: "inline" do %>
          <%= poetry_button(variant: :secondary, type: :submit) { "Run self-audit" } %>
        <% end %>
        <% if @tasks.any?(&:completed?) %>
          <%= form_with url: clear_completed_project_tasks_path(@project), method: :delete, class: "inline",
                data: { turbo_confirm: "This will permanently delete all completed tasks, their worktrees, and archived docs.\n\nAre you sure?" } do %>
            <%= poetry_button(variant: :outline, type: :submit) { "Clear completed tasks" } %>
          <% end %>
        <% end %>
        <%= form_with url: project_path(@project), method: :delete, class: "inline",
              data: { turbo_confirm: "This will delete all tasks, worktrees, and archived docs for #{@project.name}.\n\nAre you sure?" } do %>
          <%= poetry_button(variant: :destructive, type: :submit) { "Delete project" } %>
        <% end %>
        <%= poetry_button(href: new_project_task_path(@project)) do |button| %>
          <% button.with_leading { poetry_icon(name: :plus) } %>
          New task
        <% end %>
      </div>
    </div>
    <%= poetry_separator %>
  </header>

  <section class="mt-6">
    <h2 class="mb-2 text-sm font-medium text-muted-foreground">Tasks</h2>
    <% if @tasks.any? %>
      <%= poetry_item_group do %>
        <% @tasks.each_with_index do |task, index| %>
          <%= poetry_item_separator(key: task) if index.positive? %>
          <%= poetry_item(size: :sm, role: "listitem") do |item| %>
            <% item.with_title do %>
              <%= poetry_link(href: project_task_path(@project, task)) { task.title } %>
            <% end %>
            <% item.with_actions do %>
              <%= poetry_badge(variant: task_status_badge_variant(task.status)) { task.status.humanize } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <%= poetry_empty(media_variant: :icon) do |empty| %>
        <% empty.with_media { poetry_icon(name: :"list-todo") } %>
        <% empty.with_title { "No tasks yet" } %>
        <% empty.with_description { "Create a task to send the agent pipeline at this repository." } %>
        <%= poetry_button(href: new_project_task_path(@project)) { "New task" } %>
      <% end %>
    <% end %>
  </section>

  <section class="mt-8">
    <h2 class="mb-2 text-sm font-medium text-muted-foreground">Open GitHub Issues</h2>
    <% if @open_issues.present? %>
      <%= poetry_item_group do %>
        <% @open_issues.each_with_index do |issue, index| %>
          <%= poetry_item_separator(key: issue.number) if index.positive? %>
          <%= poetry_item(size: :sm, role: "listitem") do |item| %>
            <% item.with_title do %>
              <%= poetry_link(href: issue.url, external: true) { "##{issue.number} #{issue.title}" } %>
            <% end %>
            <% item.with_actions do %>
              <%= poetry_button(variant: :outline, size: :sm,
                    href: new_project_task_path(@project, from_issue: issue.number)) { "Create task" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <p class="text-sm text-muted-foreground">No open issues.</p>
    <% end %>
  </section>
</div>
