<div class="mx-auto w-full max-w-lg">
  <%= render layout: "shared/page_header",
        locals: { title: "Edit project",
                  crumbs: [["Projects", projects_path], [@project.name, project_path(@project)], ["Edit", nil]] } do %>
  <% end %>

  <%= form_with model: @project, builder: Poetry::Ui::FormBuilder, class: "mt-6" do |f| %>
    <%= poetry_field_group do %>
      <%= f.input :name %>
      <%= f.input :subproject_path, label: "Subproject path",
            hint: "Optional, for monorepos." %>
      <%= f.input :repo_folder_path, label: "Repository path",
            disabled: @project.tasks.any?,
            hint: @project.tasks.any? ? "Changing this field is blocked because the project has existing tasks." : "An existing git checkout on this machine." %>
      <%= f.submit "Save changes" %>
    <% end %>
  <% end %>

  <p class="mt-6">
    <%= poetry_link(href: project_path(@project), class: "inline-flex items-center gap-1 text-sm") do %>
      <%= poetry_icon(name: :"arrow-left", class: "size-3.5") %> Back to project
    <% end %>
  </p>
</div>
