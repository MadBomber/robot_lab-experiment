<div class="mx-auto w-full max-w-lg">
  <%= render layout: "shared/page_header",
        locals: { title: "New project",
                  crumbs: [["Projects", projects_path], ["New project", nil]] } do %>
  <% end %>

  <%= form_with model: @project, builder: Poetry::Ui::FormBuilder, class: "mt-6" do |f| %>
    <%= poetry_field_group do %>
      <%= f.input :name %>
      <%= f.input :repo_folder_path, label: "Repository path",
            hint: "An existing git checkout on this machine." %>
      <%= f.input :subproject_path, label: "Subproject path",
            hint: "Optional, for monorepos." %>
      <%= f.submit "Create project" %>
    <% end %>
  <% end %>
</div>
