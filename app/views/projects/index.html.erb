<div class="mx-auto w-full max-w-3xl">
  <%= render layout: "shared/page_header",
        locals: { title: "Projects",
                  description: "Git repositories the agent pipeline can run tasks against." } do %>
    <%= poetry_button(href: new_project_path) do |button| %>
      <% button.with_leading { poetry_icon(name: :plus) } %>
      New project
    <% end %>
  <% end %>

  <div class="mt-6">
    <%= poetry_item_group do %>
      <% @projects.each_with_index do |project, index| %>
        <%= poetry_item_separator(key: project) if index.positive? %>
        <%= poetry_item(role: "listitem") do |item| %>
          <% item.with_title do %>
            <%= poetry_link(href: project_path(project)) { project.name } %>
          <% end %>
          <% item.with_description do %>
            <span class="font-mono text-xs"><%= project.repo_folder_path %></span>
          <% end %>
          <% item.with_actions do %>
            <%= poetry_button(variant: :outline, size: :sm, href: edit_project_path(project)) { "Edit" } %>
            <%= form_with url: project_path(project), method: :delete, class: "inline",
                  data: { turbo_confirm: "Delete this project and all associated tasks/worktrees?" } do %>
              <%= poetry_button(variant: :destructive, size: :sm, type: :submit) { "Delete" } %>
            <% end %>
          <% end %>
          <% item.with_footer do %>
            <%= form_with url: update_llm_project_path(project), method: :patch,
                  class: "flex flex-wrap items-center gap-2" do %>
              <span class="text-xs text-muted-foreground">LLM:</span>
              <%# One grouped, filterable picker for the provider/model pair --
                  the value encodes both halves as "provider|model" and
                  ProjectsController#llm_params splits it back apart. %>
              <%# The placeholder is the combobox's blank option ("App default"
                  serializes as ""), and show_clear is the way back to it once
                  a real pair is committed. %>
              <%= poetry_combobox(name: "project[llm]", value: llm_choice_value(project),
                    placeholder: "App default (#{AgentRunner::DEFAULT_PROVIDER}/#{AgentRunner::DEFAULT_MODEL})",
                    search_placeholder: "Search models…", show_clear: true,
                    "aria-label": "LLM provider and model for #{project.name}",
                    width: "w-72") do |combobox| %>
                <% unless current_llm_pair_listed?(project, @llm_options) %>
                  <%# The stored override rolled off the live catalog -- keep it
                      representable instead of silently snapping to App default. %>
                  <% combobox.with_item(value: llm_choice_value(project)) do %>
                    <%= project.llm_provider %>/<%= project.llm_model %> (currently set, not in the live list)
                  <% end %>
                <% end %>
                <% llm_choice_groups(@llm_options).each do |provider, choices| %>
                  <% combobox.with_group(heading: provider) do |group| %>
                    <% choices.each do |label, value| %>
                      <% group.with_item(value:) { label } %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
              <%= poetry_button(variant: :secondary, size: :sm, type: :submit) { "Set" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if @projects.empty? %>
      <%= poetry_empty(media_variant: :icon) do |empty| %>
        <% empty.with_media { poetry_icon(name: :"folder-git-2") } %>
        <% empty.with_title { "No projects yet" } %>
        <% empty.with_description { "Point the pipeline at an existing git checkout to get started." } %>
        <%= poetry_button(href: new_project_path) { "New project" } %>
      <% end %>
    <% end %>
  </div>
</div>
