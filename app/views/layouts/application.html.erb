<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Robot Lab Experiment" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Robot Lab Experiment">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= poetry_color_scheme_script %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-background text-foreground antialiased">
    <%# Constant header: identity, navigation, and the fleet's status -- each
        status is a WORD beside its color, never color alone. %>
    <header class="flex h-14 shrink-0 items-center gap-6 border-b border-border bg-card px-5">
      <%= poetry_link(href: root_path, underline: :none, class: "inline-flex items-center gap-2 text-sm font-semibold") do %>
        <%= poetry_icon(name: :bot, class: "size-4 text-primary") %>
        Robot Lab
        <span class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Experiment</span>
      <% end %>
      <%= poetry_navigation_menu(label: "Primary") do |nav| %>
        <% nav.with_link("Projects", href: projects_path) %>
      <% end %>
      <div class="ms-auto flex items-center gap-2">
        <%= poetry_badge(variant: fleet_running_count.positive? ? :warning : :outline) do %>
          <%= poetry_spinner(label: "Agents running", class: "size-3") if fleet_running_count.positive? %>
          <%= fleet_running_count %> RUNNING
        <% end %>
        <% if fleet_blocked_count.positive? %>
          <%= poetry_badge(variant: :destructive) { "#{fleet_blocked_count} BLOCKED" } %>
        <% end %>
      </div>
    </header>

    <div class="flex min-h-0 flex-1">
      <%= render "shared/app_sidebar" %>
      <main class="min-w-0 flex-1 px-6 py-6">
        <%= yield %>
      </main>
    </div>

    <%# Constant footer: authorship plus links to the static sources. %>
    <footer class="flex h-11 shrink-0 flex-wrap items-center gap-x-5 gap-y-1 border-t border-border bg-card px-5 text-xs text-muted-foreground">
      <span>&copy; <%= Date.current.year %> Dewayne VanHoozer — an experiment, not a product</span>
      <nav aria-label="Footer" class="ms-auto flex items-center gap-4">
        <%= poetry_link(href: "https://github.com/MadBomber/robot_lab#readme", external: true, class: "text-xs") { "robot_lab README" } %>
        <%= poetry_link(href: "https://github.com/MadBomber/robot_lab-experiment", external: true, class: "text-xs") { "GitHub" } %>
      </nav>
    </footer>

    <%# The flash -> toast recipe from the Toaster contract: every flash key
        renders as a toast inside the (data-turbo-permanent) toaster region,
        and server broadcasts append here via turbo_stream.poetry_toast /
        target: "poetry-toaster". %>
    <%= poetry_toaster do %>
      <% flash.each do |kind, message| %>
        <%= poetry_toast(variant: flash_toast_variant(kind)) do |toast| %>
          <% toast.with_title { message } %>
        <% end %>
      <% end %>
    <% end %>
  </body>
</html>
