<div class="w-full max-w-4xl">
  <p class="text-sm text-gray-500 mb-1">
    <%= link_to @project.name, @project %> &middot;
    <%= link_to "task #{@task.id}", [@project, @task] %>
  </p>
  <h1 class="text-2xl font-bold mb-4">Run #<%= @agent_run.id %> (<%= @agent_run.agent_type %>)</h1>

  <div class="space-y-4">
    <% @messages.each do |message| %>
      <div class="border rounded p-3 text-sm">
        <p class="text-xs text-gray-500 mb-1"><%= message.msg_type %> &middot; <%= message.created_at %></p>
        <pre class="whitespace-pre-wrap"><%= JSON.pretty_generate(message.payload) %></pre>
      </div>
    <% end %>
  </div>

  <% if @messages.empty? %>
    <p class="text-gray-500">No transcript messages for this run.</p>
  <% end %>
</div>
