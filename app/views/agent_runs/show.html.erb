<div class="mx-auto w-full max-w-4xl">
  <header class="flex flex-col gap-4">
    <%= poetry_breadcrumb do |crumb| %>
      <% crumb.with_item(@project.name, href: project_path(@project)) %>
      <% crumb.with_item("task #{@task.id}", href: project_task_path(@project, @task)) %>
      <% crumb.with_item("run ##{@agent_run.id}") %>
    <% end %>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-semibold tracking-tight">Run #<%= @agent_run.id %></h1>
      <%= poetry_badge(variant: :outline) { @agent_run.agent_type } %>
    </div>
    <%= poetry_separator %>
  </header>

  <div class="mt-6 space-y-3">
    <% @messages.each do |message| %>
      <div class="rounded-lg border border-border bg-card px-4 py-3">
        <div class="flex items-center gap-2">
          <%= poetry_badge(variant: message_badge_variant(message.msg_type)) { message.msg_type.humanize } %>
          <span class="ms-auto font-mono text-xs tabular-nums text-muted-foreground"><%= message.created_at %></span>
        </div>
        <div class="mt-2">
          <%= poetry_code_block(code: JSON.pretty_generate(message.payload), language: "json",
                label: "Message #{message.id} payload") %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @messages.empty? %>
    <div class="mt-6">
      <%= poetry_empty(media_variant: :icon) do |empty| %>
        <% empty.with_media { poetry_icon(name: :"message-square-off") } %>
        <% empty.with_title { "No transcript" } %>
        <% empty.with_description { "No transcript messages were recorded for this run." } %>
      <% end %>
    </div>
  <% end %>
</div>
