<div class="mx-auto w-full max-w-4xl">
  <%= render layout: "shared/page_header",
        locals: { title: "Run ##{@agent_run.id}", description: "#{@agent_run.agent_type} agent",
                  crumbs: [[@project.name, project_path(@project)],
                           ["task #{@task.id}", project_task_path(@project, @task)],
                           ["run ##{@agent_run.id}", nil]] } do %>
  <% end %>

  <div class="mt-6">
    <% if @messages.any? %>
      <%= poetry_item_group(class: "space-y-3") do %>
        <% @messages.each do |message| %>
          <%= poetry_item(variant: :outline, role: "listitem") do |item| %>
            <% item.with_title do %>
              <%= poetry_badge(variant: message_badge_variant(message.msg_type)) { message.msg_type.humanize } %>
            <% end %>
            <% item.with_actions do %>
              <span class="font-mono text-xs tabular-nums text-muted-foreground"><%= message.created_at %></span>
            <% end %>
            <%= poetry_code_block(code: JSON.pretty_generate(message.payload), language: "json",
                  label: "Message #{message.id} payload") %>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <%= poetry_empty(media_variant: :icon) do |empty| %>
        <% empty.with_media { poetry_icon(name: :"message-square-off") } %>
        <% empty.with_title { "No transcript" } %>
        <% empty.with_description { "No transcript messages were recorded for this run." } %>
      <% end %>
    <% end %>
  </div>
</div>
